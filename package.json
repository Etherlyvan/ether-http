{
  "name": "ether-http",
  "version": "0.1.0",
  "private": true,
  "description": "An educational HTTP/1.1 server built on TCP",
  "type": "module",
  "exports": { ".": { "types": "./dist/lib.d.ts", "import": "./dist/lib.js" } },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
